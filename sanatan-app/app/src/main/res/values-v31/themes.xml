<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: royal maroon + app icon (matches splash_bg). -->
    <style name="Theme.SanatanHindu" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorPrimaryDark">@color/royal_maroon</item>
        <item name="colorAccent">@color/maroon</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/royal_maroon</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/royal_maroon</item>
    </style>
</resources>
