# Google Gemini API (FREE — https://aistudio.google.com/apikey)
# Google account se login karo → "Get API Key" → Copy karo
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxx

# Instagram Graph API
# Setup guide: SETUP.md dekho (Step B)
INSTAGRAM_ACCESS_TOKEN=your_long_lived_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# ImgBB API (free image hosting — https://api.imgbb.com)
# imgbb.com pe sign up karo aur free API key lo
IMGBB_API_KEY=your_imgbb_api_key_here

# Post schedule (24hr format)
POST_TIME=08:00
CLIENT_HUNT_TIME_1=12:00
CLIENT_HUNT_TIME_2=18:00

# Optional: Amazon Affiliate tag (paise kamane ke liye)
AMAZON_AFFILIATE_TAG=yourname-21
